# Database credentials
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# JWT secret key (трябва да е еднакъв във всички сервизи)
JWT_SECRET=your-jwt-secret

# Email credentials за изпращане на потвърждения за резервации
# EMAIL_USERNAME: Gmail адресът, от който се изпращат имейлите
# EMAIL_PASSWORD: Gmail App Password (не паролата на акаунта)
#   Как да го генерираш: myaccount.google.com/apppasswords
#   Изисква включено 2-Step Verification
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

classDiagram
    class Reservation {
        <<Entity>>
        +Long id
        +Long userId
        +Long restaurantId
        +Long tableId
        +LocalDate reservationDate
        +LocalTime reservationTime
        +Integer numberOfGuests
        +ReservationStatus status
        +TableLocation preferredLocation
        +String customerName
        +String customerEmail
        +String customerPhone
        +String specialRequests
        +LocalDateTime createdAt
        +LocalDateTime updatedAt
    }

    class ReservationResponse {
        <<DTO>>
        +Long id
        +Long userId
        +Long restaurantId
        +String restaurantName
        +String restaurantImageUrl
        +Long tableId
        +LocalDate reservationDate
        +LocalTime reservationTime
        +Integer numberOfGuests
        +ReservationStatus status
        +TableLocation preferredLocation
        +String customerName
        +String customerEmail
        +String customerPhone
        +String specialRequests
        +LocalDateTime createdAt
    }

    class RestaurantDTO {
        <<DTO>>
        +Long id
        +String name
        +Long ownerId
        +LocalTime openingTime
        +LocalTime closingTime
        +String imageUrl
    }

    class ReservationRepository {
        <<Repository>>
        +findActiveReservationsForRestaurant(Long, LocalDate) List~Reservation~
        +findByUserIdOrderByCreatedAtDesc(Long) List~Reservation~
        +findByUserIdAndStatusOrderByCreatedAtDesc(Long, ReservationStatus) List~Reservation~
        +findConfirmedReservationsByUserAndDate(Long, LocalDate) List~Reservation~
        +findReservationsToAutoComplete(LocalDate, LocalTime) List~Reservation~
        +findByRestaurantIdOrderByReservationDateAscReservationTimeAsc(Long) List~Reservation~
        +findByRestaurantIdAndReservationDateOrderByReservationTimeAsc(Long, LocalDate) List~Reservation~
        +findByRestaurantIdAndStatusOrderByReservationDateAscReservationTimeAsc(Long, ReservationStatus) List~Reservation~
        +findByRestaurantIdAndReservationDateAndStatusOrderByReservationTimeAsc(Long, LocalDate, ReservationStatus) List~Reservation~
    }

    class ReservationService {
        <<Service>>
        +createReservation(Long, UserRole, String, ReservationRequest) ReservationResponse
        +createReservationAsAdmin(Long, String, AdminReservationRequest) ReservationResponse
        +cancelReservation(Long, Long, UserRole) ReservationResponse
        +rejectReservation(Long, Long, UserRole, String) ReservationResponse
        +completeReservation(Long, UserRole) ReservationResponse
        +markNoShow(Long, UserRole) ReservationResponse
        +getAvailableTimeSlots(Long, LocalDate, Integer, TableLocation) List~TimeSlotResponse~
        +getReservationById(Long) ReservationResponse
        +getMyReservations(Long, ReservationStatus, LocalDate) List~ReservationResponse~
        +getMyUpcomingReservations(Long) List~ReservationResponse~
        +getAllReservations() List~ReservationResponse~
        +getRestaurantReservations(Long, LocalDate, ReservationStatus, Long, UserRole) List~ReservationResponse~
        +autoCompleteExpiredReservations() int
        -findAvailableTable(Long, LocalDate, LocalTime, Integer, TableLocation) Long
        -isTableOccupied(Long, LocalTime, List) boolean
        -validateReservationTime(Long, LocalTime) void
        -validateNoOverlappingReservation(Long, LocalDate, LocalTime) void
        -getRestaurantName(Long) String
        -getRestaurantImageUrl(Long) String
    }

    class NotificationService {
        <<interface>>
        +sendEmail(NotificationData) void
    }

    class NotificationServiceImpl {
        <<Service>>
        +sendEmail(NotificationData) void
    }

    class RestaurantServiceClient {
        <<Service>>
        +getRestaurantById(Long) RestaurantDTO
        +findTablesByCapacityAndLocation(Long, Integer, TableLocation) List~TableDTO~
    }

    class UserServiceClient {
        <<Service>>
        +getUserById(Long, String) UserDTO
    }

    class ReservationScheduler {
        <<Component>>
        +autoCompleteExpiredReservations() void
    }

    class ReservationController {
        <<RestController>>
        +createReservation() ResponseEntity
        +createReservationAsAdmin() ResponseEntity
        +cancelReservation() ResponseEntity
        +rejectReservation() ResponseEntity
        +completeReservation() ResponseEntity
        +markNoShow() ResponseEntity
        +getAvailableTimeSlots() ResponseEntity
        +getReservationById() ResponseEntity
        +getMyReservations() ResponseEntity
        +getAllReservations() ResponseEntity
        +getRestaurantReservations() ResponseEntity
    }

    class SecurityUtils {
        <<Component>>
        +getCurrentUserId() Long
        +getCurrentUserRole() String
    }

    class JwtAuthenticationDetails {
        <<Component>>
        +Long userId
        +String role
    }

    class JwtService {
        <<Service>>
        +extractUsername(String) String
        +extractUserId(String) Long
        +extractUserRole(String) String
    }

    class JwtAuthenticationFilter {
        <<Component>>
        #doFilterInternal(request, response, chain) void
    }

    class SecurityConfig {
        <<Configuration>>
        +securityFilterChain(HttpSecurity) SecurityFilterChain
    }

    class CorsConfig {
        <<Configuration>>
        +corsConfigurationSource() CorsConfigurationSource
    }

    class GlobalExceptionHandler {
        <<RestControllerAdvice>>
        +handleInvalidReservation() ResponseEntity
        +handleNoTable() ResponseEntity
        +handleValidation() ResponseEntity
    }

    NotificationServiceImpl ..|> NotificationService
    ReservationController --> ReservationService
    ReservationController --> SecurityUtils
    ReservationService --> ReservationRepository
    ReservationService --> RestaurantServiceClient
    ReservationService --> UserServiceClient
    ReservationService --> NotificationService
    ReservationService ..> ReservationResponse : returns
    RestaurantServiceClient ..> RestaurantDTO : returns
    ReservationScheduler --> ReservationService
    ReservationRepository ..> Reservation
    SecurityUtils --> JwtAuthenticationDetails
    JwtAuthenticationFilter --> JwtService
    JwtAuthenticationFilter ..> JwtAuthenticationDetails : creates
    SecurityConfig --> JwtAuthenticationFilter
    SecurityConfig --> CorsConfig
    ReservationController ..> GlobalExceptionHandler : throws exceptions
